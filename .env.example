# GROVIA - Environment Variables Template
# Copy this file to .env.local for local development or configure these variables in Vercel Project Settings.

# ==============================================================================
# 1. APPLICATION CORE CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_APP_NAME="GROVIA"
NEXT_PUBLIC_APP_TAGLINE="Fresh Living. Smarter Shopping."
# In local dev: http://localhost:3000
# On Vercel: Set to your production deployment URL (e.g., https://grovia.vercel.app or custom domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# 2. DATABASE CONFIGURATION (PRISMA ORM)
# ==============================================================================
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production & Vercel Staging (PostgreSQL - Supabase / Neon / AWS RDS / Vercel Postgres):
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
# If using Neon / Supabase connection pooling (recommended for serverless Vercel):
# DATABASE_URL="postgresql://user:password@ep-xyz-pooler.us-east-1.aws.neon.tech/grovia?sslmode=require&pgbouncer=true"
# POSTGRESQL_DIRECT_URL="postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/grovia?sslmode=require"

# ==============================================================================
# 3. AUTHENTICATION & SECURITY SECRETS (REQUIRED FOR VERCEL)
# ==============================================================================
# Generate a 32+ character random secret: openssl rand -base64 32
JWT_SECRET="grovia_super_secure_jwt_secret_key_change_in_production_2026"
NEXTAUTH_SECRET="grovia_nextauth_secret_key_change_in_production"

# Configured Initial Roster Credentials (idempotent seed)
ADMIN_LOGIN_ID="admin_me"
ADMIN_INITIAL_PASSWORD="your_strong_admin_password_here"
RIDER_LOGIN_ID="rider_me"
RIDER_INITIAL_PASSWORD="your_strong_rider_password_here"
ALLOW_DEFAULT_INITIAL_PASSWORD="false" # MUST be "false" in production/staging environments

# ==============================================================================
# 4. PAYMENT GATEWAY (RAZORPAY)
# ==============================================================================
# Set PAYMENT_MODE="DEMO" for testing without live charges, or "LIVE" for live transactions
PAYMENT_MODE="DEMO"
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"

# ==============================================================================
# 5. OAUTH & EXTERNAL INTEGRATIONS (OPTIONAL)
# ==============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/callback/google"

# ==============================================================================
# 6. MAPPING & GEOLOCATION APIS (GOOGLE MAPS)
# ==============================================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_API_KEY=""

# ==============================================================================
# 7. LOGISTICS & NATIONWIDE COURIER PARTNERS
# ==============================================================================
SHIPROCKET_API_EMAIL=""
SHIPROCKET_API_PASSWORD=""
DELHIVERY_API_TOKEN=""

# ==============================================================================
# 8. EMAIL & NOTIFICATIONS (SMTP)
# ==============================================================================
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="support@grovia.in"

